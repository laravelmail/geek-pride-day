s":"CP0CEM2rARgBIhMI3eetxM--kgMV95N8Bh0y3zJoygEEESUn7A==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CP0CEM2rARgBIhMI3eetxM--kgMV95N8Bh0y3zJoygEEESUn7A==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"From The Ascension / https://sufjanstevens.ffm.to/videogame\n\nCredits:\nDirector \nNicole Ginelli \n\nStarring \nJalaiah Harmon \n\nDirector of Photography \nAngelica Perez-Castro \n\nAssistant Camera \nAimée Schroeppel Casey \n\n2nd Assistant Camera \nCharlotte Acker \n\nGaffer \nJordan Daniels \n\nSteadicam Operator \nAngelica Perez-Castro \n\nChoreography \nJalaiah Harmon \n\nStylist \nMetta Conchetta \n\nHair \u0026 Makeup \nStefanie Harmon \n\nAnimation, Editing, VFX, Compositing  \nNicole Ginelli \n\nAdditional Motion \u0026 VFX  \nWill Rahilly  \n\nAdditional Editing  \nAlex Mallis  \n\nCo Producer\nJohn Beeler \n\nProducer\nNicole Ginelli\n\nFilmed at \nStudio Space Atlanta\n\nSpecial Thanks:\nSteven Ross, Taylor Russo\n\nLyrics:\nI don’t wanna be your personal Jesus\nI don’t wanna live inside of that flame In a way \nI wanna be my own believer\nI don’t wanna play your video game \n\nI don’t wanna be the center of the universe \nI don’t wanna be a part of that shameIn a way \nI wanna be my own redeemer\nI don’t wanna play your video game \n\nI don’t care if everybody else is into it \nI don’t care if it’s a popular refrain\nI don’t wanna be a puppet in a theater \nI don’t wanna play your video game \n\nYou don’t wanna be the one who has to pay for it \nYou don’t wanna be the one who has to change \nAll you want is what the resumé tells you\nI don’t wanna play your video game \nChorus...\n\nI don’t wanna play, I don’t wanna play (I just wanna go away)\nI don’t wanna play your video game \n\nI don’t wanna love you if won’t receive it \nI don’t wanna save the world that way\nI don’t wanna be your personal Jesus\nI don’t wanna play your video game \n\nI don’t wanna put the devil on a pedestal \nI don’t wanna put the saints in chains\nI just wanna make my life a little easier\nI don’t wanna play your video game \nChorus... \n\nI don’t wanna be your Julius Caesar\nI don’t want it to go down that way\nBut in a way you gotta follow the procedure \nSo go ahead and play your video game \nChorus... \n\nSufjan Stevens: drums and percussion, Tempest, Prophet 08, Prophet 6, vocals \nCasey Foubert: bass guitar*\nJames McAlister: additional drums and percussion*\n\n© 2020 SUFJAN STEVENS MUSIC/ASCAP \n©℗ 2020 AKR P.O. BOX 1282 LANDER, WY 82520 USA","commandRuns":[{"startIndex":21,"length":38,"onTap":{"innertubeCommand":{"clickTrackingParams":"CP0CEM2rARgBIhMI3eetxM--kgMV95N8Bh0y3zJoSM3Cv9jzrKf43QHKAQQRJSfs","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqa0xOS1laLVhHU1duYk5saG9NOXdKQkdRR0VGd3xBQ3Jtc0ttbTBhbzg5T3FVanlWX05teHlta1J5bDJ1M2tkamlJcXpwcGh4SWd4UFAtR2tFbWYxY0ZZeHE4bWZPdDVEQVhHMThiQnhoeXB0d0o2WUdodnpYcXNDZG1YbXIwTl9QakVvdHBCNFIzSWRXNzVOb3A1TQ\u0026q=https%3A%2F%2Fsufjanstevens.ffm.to%2Fvideogame\u0026v=3fCdZzsP4U0","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqa0xOS1laLVhHU1duYk5saG9NOXdKQkdRR0VGd3xBQ3Jtc0ttbTBhbzg5T3FVanlWX05teHlta1J5bDJ1M2tkamlJcXpwcGh4SWd4UFAtR2tFbWYxY0ZZeHE4bWZPdDVEQVhHMThiQnhoeXB0d0o2WUdodnpYcXNDZG1YbXIwTl9QakVvdHBCNFIzSWRXNzVOb3A1TQ\u0026q=https%3A%2F%2Fsufjanstevens.ffm.to%2Fvideogame\u0026v=3fCdZzsP4U0","target":"TARGET_NEW_WINDOW","nofollow":true}}}}],"styleRuns":[{"startIndex":0,"length":21,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"}