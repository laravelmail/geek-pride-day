luding through the links below), which are governed by the respective merchant's terms and conditions (including their privacy policy). YouTube may share information with our partners to perform services, in compliance with our privacy policy and other appropriate confidentiality and security measures. For instance, YouTube may share your IP address with the merchant platform to facilitate the transaction. Product reviews are available in selected locations only and are not verified by Google. ","textColor":4279440147},{"text":"Learn more","navigationEndpoint":{"clickTrackingParams":"CH4Qx1UiEwjd563Ez76SAxX3k3wGHTLfMmjKAQQRJSfs","commandMetadata":{"webCommandMetadata":{"url":"https://support.google.com/googleshopping/answer/9370999?nohelpkit=1","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://support.google.com/googleshopping/answer/9370999?nohelpkit=1","target":"TARGET_NEW_WINDOW"}}}]},"confirmLabel":{"simpleText":"OK"},"trackingParams":"CH4Qx1UiEwjd563Ez76SAxX3k3wGHTLfMmg="}},"popupType":"DIALOG"}},"trackingParams":"CGgQw9AHGAAiEwjd563Ez76SAxX3k3wGHTLfMmg="}},{"menuServiceItemRenderer":{"text":{"accessibility":{"accessibilityData":{"label":"Report listing"}},"simpleText":"Report listing"},"icon":{"iconType":"FLAG"},"serviceEndpoint":{"clickTrackingParams":"CH0Q1tgHGA8iEwjd563Ez76SAxX3k3wGHTLfMmjKAQQRJSfs","commandMetadata":{"webCommandMetadata":{"url":"https://accounts.google.com/ServiceLogin?service=youtube\u0026uilel=3\u0026passive=true\u0026continue=https%3A%2F%2Fwww.youtube.com%2Fsignin%3Faction_handle_signin%3Dtrue%26app%3Ddesktop%26hl%3Den-GB\u0026hl=en-GB","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"signInEndpoint":{"nextEndpoint":{"clickTrackingParams":"CH0Q1tgHGA8iEwjd563Ez76SAxX3k3wGHTLfMmjKAQQRJSfs","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/flag/get_form"}},"getReportFormEndpoint":{"params":""}}}},"trackingParams":"CH0Q1tgHGA8iEwjd563Ez76SAxX3k3wGHTLfMmg=","loggingDire