Date":{"simpleText":"Premiered on 13 Aug 2020"},"channelNavigationEndpoint":{"clickTrackingParams":"CB4Q040EGAciEwjd563Ez76SAxX3k3wGHTLfMmjKAQQRJSfs","commandMetadata":{"webCommandMetadata":{"url":"/@SufjanStevensOfficial","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCMi8tQF_L7rd6YcmSt7MXrQ","canonicalBaseUrl":"/@SufjanStevensOfficial"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/6PZrGcZK3aY1YEAc4qMSxp-6mn4fluOU3mZuw_tGj-kXkcGOvYta-57ewkW4hzR1pTR6vOWdCw=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"From The Ascension / https://sufjanstevens.ffm.to/videogame\n\nCredits:\nDirector \nNicole Ginelli \n\nStarring \nJalaiah Harmon \n\nDirector of Photography \nAngelica Perez-Castro \n\nAssistant Camera \nAimée Schroeppel Casey \n\n2nd Assistant Camera \nCharlotte Acker \n\nGaffer \nJordan Daniels \n\nSteadicam Operator \nAngelica Perez-Castro \n\nChoreography \nJalaiah Harmon \n\nStylist \nMetta Conchetta \n\nHair \u0026 Makeup \nStefanie Harmon \n\nAnimation, Editing, VFX, Compositing  \nNicole Ginelli \n\nAdditional Motion \u0026 VFX  \nWill Rahilly  \n\nAdditional Editing  \nAlex Mallis  \n\nCo Producer\nJohn Beeler \n\nProducer\nNicole Ginelli\n\nFilmed at \nStudio Space Atlanta\n\nSpecial Thanks:\nSteven Ross, Taylor Russo\n\nLyrics:\nI don’t wanna be your personal Jesus\nI don’t wanna live inside of that flame In a way \nI wanna be my own believer\nI don’t wanna play your video game \n\nI don’t wanna be the center of the universe \nI don’t wanna be a part of that shameIn a way \nI wanna be my own redeemer\nI don’t wanna play your video game \n\nI don’t care if everybody else is into it \nI don’t care if it’s a popular refrain\nI don’t wanna be a puppet in a theater \nI don’t wanna play your video game \n\nYou don’t wanna be the one who has to pay for it \nYou don’t wanna be the one who has to change \nAll you want is what the resumé tells you\nI don’t wanna play your video game \nChorus...\n\nI don’t wanna play, I don’t wanna play (I just wanna go away)\nI don’t wanna play your video game \n\nI don’t wanna love you if won’t receive it \nI don’t wanna save the world that way\nI don’t wanna be your personal Jesus\nI don’t wanna play your video game \n\nI don’t wanna put the devil on a pedestal \nI don’t wanna put the saints in chains\nI just wanna make my life a little easier\nI don’t wanna play your video game \nChorus... \n\nI don’t wanna be your Julius Caesar\nI don’t want it to go down that way\nBut in a way you gotta follow the procedure \nSo go ahead and play your video game \nChorus... \n\nSufjan Stevens: drums and percussion, Tempest, Prophet 08, Prophet 6, vocals \nCasey Foubert: bass guitar*\nJames McAlister: additional drums and percussion*\n\n© 2020 SUFJAN STEVENS MUSIC/ASCAP \n©℗ 2020 AKR P.O. BOX 1282 LANDER, WY 82520 USA","commandRuns":[{"startIndex":21,"length":38,"onTap":{"innertubeCommand":{"clickTrackingParams":"CB4Q040EGAciEwjd563Ez76SAxX3k3wGHTLfMmhIzcK_2POsp_jdAcoBBBElJ-w=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbU83YUtJNjE5Q1ZxMEdGcWlzT2h4MlU0aDRXZ3xBQ3Jtc0tsVm9ULXNOM2FENXU0UkRYZnRqUE9KdzZvX0ZQUkNvV2lyM2RwRUVkZUpSZV9DaHJaMm1SQjMyaTA2Zl9sdjE2RmxLYnpVcU5XcUluU1Q1YW5uQTJxQloyUVpjUXJzbERhdHBaNjNpckhhaWdSb3lXcw\u0026q=https%3A%2F%2Fsufjanstevens.ffm.to%2Fvideogame\u0026v=3fCdZzsP4U0","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbU83YUtJNjE5Q1ZxMEdGcWlzT2h4MlU0aDRXZ3xBQ3Jtc0tsVm9ULXNOM2FENXU0UkRYZnRqUE9KdzZvX0ZQUkNvV2lyM2RwRUVkZUpSZV9DaHJaMm1SQjMyaTA2Zl9sdjE2RmxLYnpVcU5XcUluU1Q1YW5uQTJxQloyUVpjUXJzbERhdHBaNjNp